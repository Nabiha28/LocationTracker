<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Theme Base Palettes -->
    <Color x:Key="PrimaryDark">#0F172A</Color>
    <Color x:Key="SecondaryDark">#1E293B</Color>
    <Color x:Key="CardBackground">#1E293B</Color>
    <Color x:Key="CardBorder">#334155</Color>

    <!-- Accent Highlights -->
    <Color x:Key="AccentCyan">#06B6D4</Color>
    <Color x:Key="AccentIndigo">#6366F1</Color>
    <Color x:Key="AccentEmerald">#10B981</Color>
    <Color x:Key="AccentAmber">#F59E0B</Color>
    <Color x:Key="AccentRose">#F43F5E</Color>

    <!-- Typography -->
    <Color x:Key="TextPrimary">#F8FAFC</Color>
    <Color x:Key="TextSecondary">#94A3B8</Color>
    <Color x:Key="TextMuted">#64748B</Color>

    <!-- Translucent Overlays -->
    <Color x:Key="GlassOverlay">#E61E293B</Color>
    <Color x:Key="GlassBorder">#40FFFFFF</Color>

    <!-- Standard Aliases -->
    <Color x:Key="Primary">#6366F1</Color>
    <Color x:Key="Secondary">#06B6D4</Color>
    <Color x:Key="Tertiary">#10B981</Color>
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>

</ResourceDictionary>
